# Server
PORT=3000
NODE_ENV=development

# Logging (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# WhatsApp auth directory
AUTH_DIR=./auth_info

# API Key (leave empty to disable authentication)
API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Baileys configuration
BAILEYS_BROWSER=Chrome (Linux)
BAILEYS_MARK_ONLINE=true
BAILEYS_KEEPALIVE_MS=30000

# Reconnect delay (exponential backoff)
RECONNECT_DELAY_INITIAL=5000
RECONNECT_DELAY_MAX=60000
